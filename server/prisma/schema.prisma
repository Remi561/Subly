// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                       String @id @default(cuid())

  clerkId                  String @unique

  firstName                String? 
  lastName                 String?
  username                 String @unique 
  email                    String @unique
  

  baseCurrency             String @default("USD")
  role                     Role @default(USER)
  
  subscriptionRecords      Subscription[]
  notificationRecords      Notification[]
  historyRecords           History[] 

  reminderDaysBefore       Int       @default(3)
  emailNofiticationEnabled Boolean @default(true)
  emailVerified            EmailVerified @default(VERIFIED)
  
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@index([clerkId])
  @@index([id])
}



model Subscription {
  id                String @id @default(cuid())
  userId            String
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  name              String
  linkToSite        String?
  category          Category   @default(OTHER)

  amount            Decimal    @db.Decimal(12,2)
  currency          String
  exchangeRate      Decimal    @db.Decimal(12,4)
  settledAmount     Decimal    @db.Decimal(12,2)

  billingCycle      BillingCycle @default(MONTHLY)
  status            Status       @default(ACTIVE)
  nextBillingDate   DateTime


  reminderSent       Boolean     @default(false)
 

  expiredEmailSent   Boolean     @default(false)
  expiredEmailSentAt DateTime?



  createdAt          DateTime    @default(now())
  updateAt           DateTime    @updatedAt
  
  @@index([userId])
  @@index([userId, status])
  @@index([status, nextBillingDate])
  @@unique([userId, name])
}


model History {
  id              String @id @default(cuid())
  userId          String
  user            User @relation(fields: [userId], references: [id], onDelete: Cascade)

 
  subscriptionName String

  
  category         Category @default(OTHER)

  paidAmount       Decimal @db.Decimal(12, 2)
  paidCurrency     String

  baseCurrency     String
  exchangeRate     Decimal @db.Decimal(12, 4)
  settledAmount    Decimal @db.Decimal(12, 2)

  paidAt           DateTime @default(now())

  type             Type @default(CREATED)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
  @@index([paidAt])

}

model Notification{
  id         String @id @default(cuid())
  userId     String
  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)

  title      String
  message    String


  createdAt DateTime @default(now())

  @@index([userId])
}


model Rates{
  id           String @id @default(cuid())
  baseCurrency String @unique
  rates        Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// enum 

enum Role {
  USER
  ADMIN
}
enum BillingCycle {
  MONTHLY
  WEEKLY
  YEARLY
}

enum Status {
  ACTIVE
  EXPIRED
  CANCELLED
  ARCHIVED
}

enum Category {
  ENTERTAINMENT
  PRODUCTIVITY
  SOFTWARE
  STORAGE
  EDUCATION
  AI_TOOLS
  OTHER
}

enum Type {
  CREATED
  EDITED
  RENEWED
}

enum EmailVerified {
  VERIFIED
  UNVERIFIED
}

